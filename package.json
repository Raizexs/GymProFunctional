{
  "name": "gym-pro-funcional",
  "version": "1.0.0",
  "description": "Sistema de Gestión Digital para Gimnasio Pro Funcional",
  "main": "src/backend/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd src/backend && nodemon server.js",
    "client": "cd src/frontend && npm start",
    "build": "cd src/frontend && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "cypress run",
    "install-all": "npm install && cd src/frontend && npm install && cd ../backend && npm install"
  },
  "keywords": ["gym", "management", "reservations", "payments", "fitness"],
  "author": "Gimnasio Pro Funcional",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "cypress": "^13.6.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "stripe": "^14.7.0",
    "nodemailer": "^6.9.7",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5"
  }
}
