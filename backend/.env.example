# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@gymprofuncional.qzszpuf.mongodb.net/?appName=GymProFuncional

# Server Configuration
PORT=3000
CORS_ORIGIN=http://localhost:5173

# JWT Secret
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your_secret_key_here_change_in_production

# Transacciones (opcional)
# false = sin transacciones (para MongoDB sin replica set)
# true o vacío = con transacciones (requiere replica set o MongoDB Atlas)
USE_TRANSACTIONS=false

# ============================================
# 💳 CONFIGURACIÓN DE STRIPE
# ============================================
# Obtén tus claves de: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================
# 📧 CONFIGURACIÓN DE EMAIL (SMTP)
# ============================================
# Usar Gmail (opción recomendada para desarrollo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion

# Email remitente
SMTP_FROM=Gimnasio Pro <noreply@gimnasiopro.com>

# ============================================
# 📝 INSTRUCCIONES PARA GMAIL
# ============================================
# Para usar Gmail debes:
# 1. Activar la verificación en dos pasos en tu cuenta de Google
# 2. Generar una "Contraseña de aplicación":
#    - Ve a https://myaccount.google.com/security
#    - En "Verificación en dos pasos", busca "Contraseñas de aplicaciones"
#    - Genera una contraseña para "Correo" en "Otro (nombre personalizado)"
#    - Usa esa contraseña de 16 caracteres en SMTP_PASS